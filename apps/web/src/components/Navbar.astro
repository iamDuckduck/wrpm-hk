---
import type {SiteBranding} from '../lib/site-branding'
import {
  getLocaleCopy,
  getLocalizedPath,
  getLocalePath,
  SUPPORTED_LOCALES,
  type Locale,
} from '../lib/localization'

interface Props {
  branding: SiteBranding
  locale: Locale
}

const {branding, locale} = Astro.props
const copy = getLocaleCopy(locale)
const hasLogo = Boolean(branding.logoUrl)
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'

function isCurrentRoute(path: string, includeChildren = false) {
  const normalizedPath = path.replace(/\/+$/, '') || '/'

  return includeChildren
    ? currentPath === normalizedPath || currentPath.startsWith(`${normalizedPath}/`)
    : currentPath === normalizedPath
}

function localeShortName(supportedLocale: Locale) {
  return supportedLocale === 'zh-HK' ? '繁中' : supportedLocale.toUpperCase()
}
---

<header class="site-header">
  <div class="site-header__inner container">
    <details class="mobile-navigation">
      <summary aria-label={copy.navigation}>
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <nav class="mobile-navigation__panel" aria-label={copy.navigation}>
        <a
          class="mobile-navigation__link"
          href={getLocalePath(locale)}
          aria-current={isCurrentRoute(getLocalePath(locale)) ? 'page' : undefined}
        >
          <span>{copy.home}</span>
          <span aria-hidden="true">01</span>
        </a>
        <a
          class="mobile-navigation__link"
          href={getLocalizedPath(locale, '/members')}
          aria-current={isCurrentRoute(getLocalizedPath(locale, '/members'), true) ? 'page' : undefined}
        >
          <span>{copy.members}</span>
          <span aria-hidden="true">02</span>
        </a>
        <a
          class="mobile-navigation__link"
          href={getLocalizedPath(locale, '/league')}
          aria-current={isCurrentRoute(getLocalizedPath(locale, '/league'), true) ? 'page' : undefined}
        >
          <span>{copy.league}</span>
          <span aria-hidden="true">03</span>
        </a>
      </nav>
    </details>

    <a
      class="site-brand"
      class:site-brand--has-logo={hasLogo}
      href={getLocalePath(locale)}
      aria-label={`${branding.organizationName} ${copy.home}`}
    >
      {branding.logoUrl && (
        <img
          class="site-brand__logo"
          src={branding.logoUrl}
          alt={branding.logoAlt}
          width="160"
        />
      )}
      <span>{branding.organizationName}</span>
    </a>

    <details class="mobile-language-switcher">
      <summary aria-label={`${copy.languageSwitcher}: ${copy.localeNames[locale]}`}>
        <span>{localeShortName(locale)}</span>
        <span aria-hidden="true">⌄</span>
      </summary>
      <nav class="mobile-language-switcher__panel" aria-label={copy.languageSwitcher}>
        {SUPPORTED_LOCALES.map((supportedLocale) => (
          <a
            class="mobile-language-switcher__link"
            href={getLocalePath(supportedLocale)}
            aria-current={supportedLocale === locale ? 'page' : undefined}
          >
            {copy.localeNames[supportedLocale]}
          </a>
        ))}
      </nav>
    </details>

    <nav class="language-switcher" aria-label={copy.languageSwitcher}>
      {SUPPORTED_LOCALES.map((supportedLocale) => (
        <a
          class="language-switcher__link"
          class:language-switcher__link--current={supportedLocale === locale}
          href={getLocalePath(supportedLocale)}
          aria-label={copy.localeNames[supportedLocale]}
          aria-current={supportedLocale === locale ? 'page' : undefined}
        >
          {localeShortName(supportedLocale)}
        </a>
      ))}
    </nav>

  </div>
</header>
