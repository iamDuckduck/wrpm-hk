---
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  getLocalizedPath,
  getLocaleCopy,
  getSanityLocaleKey,
  type Locale,
} from '../lib/localization'
import {
  calculateLeagueStandings,
  groupMatchesByRound,
} from '../lib/league-ranking'
import {formatScore} from '../lib/format-score'
import {buildSanityImageUrl} from '../lib/sanity-image'
import {sanityClient} from '../lib/sanity'
import {HOME_PAGE_QUERY, type HomePageQueryResult} from '../queries/home-page'
import {
  CURRENT_LEAGUE_QUERY,
  LEAGUE_SEASON_BY_SLUG_QUERY,
  type CurrentLeague,
} from '../queries/league'

interface Props {
  locale: Locale
  seasonSlug?: string
}

const {locale, seasonSlug} = Astro.props
const copy = getLocaleCopy(locale)
const localeKey = getSanityLocaleKey(locale)
const isSeasonPage = Boolean(seasonSlug)
const leagueQuery = seasonSlug ? LEAGUE_SEASON_BY_SLUG_QUERY : CURRENT_LEAGUE_QUERY
const leagueQueryParams = seasonSlug ? {locale: localeKey, seasonSlug} : {locale: localeKey}

const [homepage, currentLeague] = await Promise.all([
  sanityClient.fetch<HomePageQueryResult>(HOME_PAGE_QUERY, {locale: localeKey}),
  sanityClient.fetch<CurrentLeague | null>(leagueQuery, leagueQueryParams),
])

const participants = currentLeague?.participants ?? []
const matches = currentLeague?.matches ?? []
const participantsById = new Map(
  participants.map((participant) => [participant.memberId, participant]),
)
const standings = currentLeague
  ? calculateLeagueStandings(
      participants.map((participant) => ({
        memberId: participant.memberId,
        name: participant.name || copy.memberUnknown,
        slug: participant.slug,
      })),
      matches.map((match) => ({
        id: match._id,
        results: match.results ?? [],
      })),
    )
  : []
const matchRounds = groupMatchesByRound(
  matches.map((match) => ({
    id: match._id,
    round: match.round,
    scheduledAt: match.scheduledAt,
    results: match.results ?? [],
  })),
)
const hasRankedStandings = standings.some((standing) => standing.rank !== null)
const pageTitle = currentLeague?.title?.trim() || copy.leagueOverview
const seasonTitle = currentLeague?.seasonTitle?.trim()
const seasons = currentLeague?.seasons ?? []

function formatMatchDate(value: string) {
  return new Intl.DateTimeFormat(locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(new Date(value))
}
---

<BaseLayout title={pageTitle} locale={locale} siteSettings={homepage.siteSettings}>
  <section class="league-overview-page container" aria-labelledby="league-overview-title">
    <header class="league-overview-page__header">
      <p class="league-overview-page__eyebrow">{copy.league}</p>
      <h1 id="league-overview-title">{pageTitle}</h1>
      {seasonTitle && <p class="league-overview-page__season">{seasonTitle}</p>}
      {currentLeague?.intro?.trim() && (
        <p class="league-overview-page__intro">{currentLeague.intro}</p>
      )}
    </header>

    {currentLeague ? (
      <>
        <article class="league-overview">
          {!isSeasonPage ? (
            <>
              {currentLeague.description?.trim() && (
                <section
                  class="league-overview__description"
                  aria-labelledby="league-description-title"
                >
                  <p class="league-overview__label">{copy.leagueOverview}</p>
                  <h2 id="league-description-title">{copy.leagueOverview}</h2>
                  <p>{currentLeague.description}</p>
                </section>
              )}

              <section class="league-overview__ranking" aria-labelledby="league-ranking-title">
                <div class="league-overview__section-heading">
                  <p class="league-overview__label">{copy.league}</p>
                  <h2 id="league-ranking-title">{copy.leagueRanking}</h2>
                </div>

                {hasRankedStandings ? (
                  <ol class="league-ranking-list">
                    {standings.map((standing) => {
                      const participant = participantsById.get(standing.memberId)
                      const name = standing.name || copy.memberUnknown
                      const imageUrl = buildSanityImageUrl(participant?.profileImage, {width: 128})

                      return (
                        <li>
                          <a
                            class="league-ranking-row"
                            href={getLocalizedPath(locale, `/members/${standing.slug}`)}
                          >
                            <span class="league-ranking-row__rank">
                              #{standing.rank ?? '—'}
                            </span>
                            <span class="league-ranking-row__avatar">
                              {imageUrl ? (
                                <img
                                  src={imageUrl}
                                  alt=""
                                  width="64"
                                  height="64"
                                  loading="lazy"
                                />
                              ) : (
                                <span aria-hidden="true">{name.slice(0, 1)}</span>
                              )}
                            </span>
                            <span class="league-ranking-row__content">
                              <strong>{name}</strong>
                            </span>
                            <span class="league-ranking-row__stats">
                              <span>
                                <span>{copy.leagueScore}</span>
                                <b>{standing.matchesPlayed > 0 ? formatScore(standing.totalScore) : '—'}</b>
                              </span>
                              <span>
                                <span>{copy.leagueMatchesPlayed}</span>
                                <b>{standing.matchesPlayed > 0 ? standing.matchesPlayed : '—'}</b>
                              </span>
                            </span>
                          </a>
                        </li>
                      )
                    })}
                  </ol>
                ) : (
                  <p class="league-overview__empty">{copy.leagueNoRankings}</p>
                )}
              </section>
            </>
          ) : (
            <section class="league-overview__results" aria-labelledby="league-results-title">
              <div class="league-overview__section-heading">
                <p class="league-overview__label">{copy.league}</p>
                <h2 id="league-results-title">{copy.leagueResults}</h2>
              </div>

              {matchRounds.length > 0 ? (
                <ol class="league-rounds">
                  {matchRounds.map((round) => (
                    <li class="league-round">
                      <h2>{copy.leagueRound(round.round)}</h2>
                      <ol class="league-round__games">
                        {round.matches.map((match) => (
                          <li class="league-game">
                            <header class="league-game__header">
                              <h3>
                                <time datetime={match.scheduledAt}>
                                  {formatMatchDate(match.scheduledAt)}
                                </time>
                              </h3>
                            </header>

                            {match.results.length > 0 ? (
                              <ol class="league-game__results">
                                {match.results.map((result) => {
                                  const participant = participantsById.get(result.memberId)
                                  const name = participant?.name?.trim() || copy.memberUnknown
                                  const imageUrl = buildSanityImageUrl(
                                    participant?.profileImage,
                                    {width: 112},
                                  )

                                  return (
                                    <li class="league-game-member">
                                      <span class="league-game-member__avatar">
                                        {imageUrl ? (
                                          <img
                                            src={imageUrl}
                                            alt=""
                                            width="56"
                                            height="56"
                                            loading="lazy"
                                          />
                                        ) : (
                                          <span aria-hidden="true">{name.slice(0, 1)}</span>
                                        )}
                                      </span>
                                      <span class="league-game-member__content">
                                        <span class="league-game-member__place">
                                          #{result.placement}
                                        </span>
                                        {participant?.slug ? (
                                          <a
                                            href={getLocalizedPath(
                                              locale,
                                              `/members/${participant.slug}`,
                                            )}
                                          >
                                            {name}
                                          </a>
                                        ) : (
                                          <span>{name}</span>
                                        )}
                                        <strong>{formatScore(result.score)}</strong>
                                      </span>
                                    </li>
                                  )
                                })}
                              </ol>
                            ) : (
                              <p class="league-overview__empty">{copy.leagueResultsEmpty}</p>
                            )}
                          </li>
                        ))}
                      </ol>
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="league-overview__empty">{copy.leagueResultsEmpty}</p>
              )}
            </section>
          )}
        </article>

        {seasons.length > 0 && (
          <nav class="league-season-selector" aria-label={copy.leagueSeasonSelector}>
            <p class="league-overview__label">{copy.leagueSeasons}</p>
            <ul>
              {seasons.map((season) => (
                <li>
                  <a
                    href={getLocalizedPath(locale, `/league/${season.slug}`)}
                    aria-current={season.slug === currentLeague.seasonSlug ? 'page' : undefined}
                  >
                    <span>{season.title || season.slug}</span>
                    {season.slug === currentLeague.seasonSlug && (
                      <span class="league-season-selector__current">
                        {copy.leagueSeasonCurrent}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </>
    ) : (
      <p class="league-overview__empty" role="status">{copy.leagueNotFound}</p>
    )}
  </section>
</BaseLayout>

<style>
  .league-overview-page {
    padding-block: 4rem 6rem;
  }

  .league-overview-page__header {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .league-overview-page__eyebrow,
  .league-overview__label {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .league-overview-page h1 {
    margin: 0.75rem 0 0;
    color: var(--color-on-background);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7vw, 5rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .league-overview-page__intro {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    color: var(--color-on-surface-variant);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .league-overview-page__season {
    margin: 0.75rem 0 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .league-overview {
    display: grid;
    gap: 1px;
    background: var(--color-outline);
  }

  .league-overview__description,
  .league-overview__ranking,
  .league-overview__results {
    padding: 2rem 1.5rem;
    background: var(--color-surface-container);
  }

  .league-overview__description h2,
  .league-overview__ranking h2,
  .league-overview__results h2,
  .league-round h2 {
    margin: 0.5rem 0 0;
    color: var(--color-on-background);
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .league-overview__description > p:last-child {
    max-width: 50rem;
    margin: 1rem 0 0;
    color: var(--color-on-surface-variant);
    line-height: 1.7;
    white-space: pre-line;
  }

  .league-overview__section-heading {
    margin-bottom: 1.5rem;
  }

  .league-ranking-list,
  .league-rounds,
  .league-round__games,
  .league-game__results {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .league-ranking-row {
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: 2.5rem 3.5rem minmax(0, 1fr);
    grid-template-areas:
      'rank avatar content'
      'rank avatar stats';
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 0.35rem;
    border: 1px solid var(--color-outline);
    padding: 0.85rem 1rem;
    color: var(--color-on-background);
    background: var(--color-surface-lowest);
    text-decoration: none;
  }

  .league-ranking-row:hover {
    border-color: var(--color-primary);
  }

  .league-ranking-row__rank {
    grid-area: rank;
    align-self: start;
    padding-top: 0.15rem;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .league-ranking-row__avatar,
  .league-game-member__avatar {
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-outline);
    border-radius: 50%;
    color: var(--color-primary);
    background: var(--color-surface-high);
    font-family: var(--font-display);
  }

  .league-ranking-row__avatar {
    grid-area: avatar;
    width: 3.5rem;
    height: 3.5rem;
    font-size: 1.5rem;
  }

  .league-ranking-row__avatar img,
  .league-game-member__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .league-game-member__content {
    display: grid;
    min-width: 0;
    gap: 0.35rem;
  }

  .league-game-member__place {
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .league-ranking-row__content {
    grid-area: content;
    min-width: 0;
  }

  .league-ranking-row__content > strong {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .league-ranking-row__stats {
    display: flex;
    grid-area: stats;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    min-width: 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.72rem;
  }

  .league-ranking-row__stats > span {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 7.5rem;
  }

  .league-ranking-row__stats b {
    color: var(--color-on-background);
  }

  @media (min-width: 48rem) {
    .league-ranking-row {
      grid-template-columns: 3rem 4rem minmax(0, 1fr) auto auto;
      grid-template-areas: 'rank avatar content stats stats';
      column-gap: 1rem;
      row-gap: 0;
      padding: 0.75rem 1rem;
    }

    .league-ranking-row__rank {
      align-self: center;
      padding-top: 0;
    }

    .league-ranking-row__avatar {
      width: 4rem;
      height: 4rem;
    }

    .league-ranking-row__stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(7.5rem, auto));
      gap: 1.5rem;
    }

    .league-ranking-row__stats > span {
      min-width: 0;
    }
  }

  @media (max-width: 23rem) {
    .league-ranking-row {
      grid-template-columns: 2rem 3rem minmax(0, 1fr);
      padding-inline: 0.75rem;
    }

    .league-ranking-row__avatar {
      width: 3rem;
      height: 3rem;
    }

    .league-ranking-row__stats > span {
      min-width: 0;
    }
  }

  .league-rounds {
    gap: 2rem;
  }

  .league-round {
    display: grid;
    gap: 1rem;
  }

  .league-round > h2 {
    margin: 0;
    border-left: 4px solid var(--color-primary);
    padding-left: 0.75rem;
    font-size: 1.25rem;
  }

  .league-game {
    border: 1px solid var(--color-outline);
    padding: 1rem;
    background: var(--color-surface-lowest);
  }

  .league-game__header {
    border-bottom: 1px solid var(--color-outline);
    padding-bottom: 0.75rem;
  }

  .league-game__header h3 {
    margin: 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .league-game__results {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1rem;
    background: var(--color-outline);
  }

  .league-game-member {
    display: grid;
    min-width: 0;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem;
    background: var(--color-surface-container);
  }

  .league-game-member__avatar {
    width: 3.5rem;
    height: 3.5rem;
    font-size: 1.25rem;
  }

  .league-game-member__content a,
  .league-game-member__content > span:not(.league-game-member__place) {
    overflow: hidden;
    color: var(--color-on-background);
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    text-overflow: ellipsis;
    text-decoration: none;
    white-space: nowrap;
  }

  .league-game-member__content a:hover {
    color: var(--color-primary);
  }

  .league-game-member__content strong {
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .league-overview__empty {
    margin: 0;
    border-left: 3px solid var(--color-primary);
    padding: 1.25rem 1.5rem;
    color: var(--color-on-surface-variant);
    background: var(--color-surface-lowest);
  }

  .league-season-selector {
    margin-top: 1px;
    padding: 2rem 1.5rem;
    background: var(--color-surface-container);
  }

  .league-season-selector ul {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .league-season-selector a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-outline);
    padding: 0.75rem 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .league-season-selector a:hover,
  .league-season-selector a[aria-current='page'] {
    color: var(--color-primary);
  }

  .league-season-selector__current {
    color: var(--color-primary);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .league-overview-page {
      padding-block: 5rem 8rem;
    }

    .league-overview__description,
    .league-overview__ranking,
    .league-overview__results,
    .league-season-selector {
      padding: 3rem clamp(2rem, 5vw, 5rem);
    }

  }

  @media (min-width: 64rem) {
    .league-round__games {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

</style>
