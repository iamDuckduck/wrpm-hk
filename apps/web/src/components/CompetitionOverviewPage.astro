---
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  getLocalizedPath,
  getLocaleCopy,
  getSanityLocaleKey,
  type Locale,
} from '../lib/localization'
import {flattenCompletedMatches} from '../lib/competition-matches'
import {calculateCompetitionStandings} from '../lib/competition-ranking'
import {formatScore} from '../lib/format-score'
import {buildSanityImageUrl} from '../lib/sanity-image'
import {sanityClient} from '../lib/sanity'
import {HOME_PAGE_QUERY, type HomePageQueryResult} from '../queries/home-page'
import {
  COMPETITION_SEASON_BY_SLUG_QUERY,
  CURRENT_COMPETITION_QUERY,
  type CompetitionPageData,
} from '../queries/competition'

interface Props {
  locale: Locale
  competitionSlug: string
  seasonSlug?: string
}

const {locale, competitionSlug, seasonSlug} = Astro.props
const copy = getLocaleCopy(locale)
const localeKey = getSanityLocaleKey(locale)
const competitionQuery = seasonSlug
  ? COMPETITION_SEASON_BY_SLUG_QUERY
  : CURRENT_COMPETITION_QUERY
const competitionQueryParams = seasonSlug
  ? {locale: localeKey, competitionSlug, seasonSlug}
  : {locale: localeKey, competitionSlug}

const [homepage, competition] = await Promise.all([
  sanityClient.fetch<HomePageQueryResult>(HOME_PAGE_QUERY, {locale: localeKey}),
  sanityClient.fetch<CompetitionPageData | null>(competitionQuery, competitionQueryParams),
])

const selectedSeason = competition?.season ?? null
const participants = selectedSeason?.participants ?? []
const matches = flattenCompletedMatches(selectedSeason?.stages)
const participantsById = new Map(
  participants.map((participant) => [participant.memberId, participant]),
)
const standings = selectedSeason
  ? calculateCompetitionStandings(
      participants.map((participant) => ({
        memberId: participant.memberId,
        name: participant.name || copy.memberUnknown,
        slug: participant.slug,
      })),
      matches,
    )
  : []
const hasRankedStandings = standings.some((standing) => standing.rank !== null)
const pageTitle = competition?.title?.trim() || copy.competitionOverview
const seasonTitle = selectedSeason?.seasonTitle?.trim()
const seasons = competition?.seasons ?? selectedSeason?.seasons ?? []
const matchesPath = selectedSeason
  ? getLocalizedPath(
      locale,
      `/competitions/${competitionSlug}/${selectedSeason.seasonSlug}/matches`,
    )
  : getLocalizedPath(locale, `/competitions/${competitionSlug}`)

function formatCompetitionStatus(status: 'upcoming' | 'ongoing' | 'completed') {
  return copy.competitionStatus(status)
}
---

<BaseLayout title={pageTitle} locale={locale} siteSettings={homepage.siteSettings}>
  <section class="competition-overview-page container" aria-labelledby="competition-overview-title">
    <header class="competition-overview-page__header">
      <p class="competition-overview-page__eyebrow">{copy.competition}</p>
      <h1 id="competition-overview-title">{pageTitle}</h1>
      {(seasonTitle || selectedSeason) && (
        <div class="competition-overview-page__season-row">
          {seasonTitle && <p class="competition-overview-page__season">{seasonTitle}</p>}
          {selectedSeason && (
            <p class="competition-overview-page__status">
              {formatCompetitionStatus(selectedSeason.seasonStatus)}
            </p>
          )}
        </div>
      )}
      {competition?.intro?.trim() && (
        <p class="competition-overview-page__intro">{competition.intro}</p>
      )}
    </header>

    {competition && selectedSeason ? (
      <>
        <article class="competition-overview">
          {competition.description?.trim() && (
            <section
              class="competition-overview__description"
              aria-labelledby="competition-description-title"
            >
              <h2 id="competition-description-title">{copy.competitionOverview}</h2>
              <p>{competition.description}</p>
            </section>
          )}

          <section class="competition-overview__ranking" aria-labelledby="competition-ranking-title">
            <div class="competition-overview__section-heading">
              <h2 id="competition-ranking-title">{copy.competitionRanking}</h2>
            </div>

            {hasRankedStandings ? (
              <ol class="competition-ranking-list">
                {standings.map((standing) => {
                  const participant = participantsById.get(standing.memberId)
                  const name = standing.name || copy.memberUnknown
                  const imageUrl = buildSanityImageUrl(participant?.profileImage, {width: 128})

                  return (
                    <li>
                      <a
                        class="competition-ranking-row"
                        href={getLocalizedPath(locale, `/members/${standing.slug}`)}
                      >
                        <span class="competition-ranking-row__rank">
                          #{standing.rank ?? '—'}
                        </span>
                        <span class="competition-ranking-row__avatar">
                          {imageUrl ? (
                            <img
                              src={imageUrl}
                              alt=""
                              width="64"
                              height="64"
                              loading="lazy"
                            />
                          ) : (
                            <span aria-hidden="true">{name.slice(0, 1)}</span>
                          )}
                        </span>
                        <span class="competition-ranking-row__content">
                          <strong>{name}</strong>
                        </span>
                        <span class="competition-ranking-row__stats">
                          <span>
                            <span>{copy.competitionScore}</span>
                            <b>{standing.matchesPlayed > 0 ? formatScore(standing.totalScore) : '—'}</b>
                          </span>
                          <span>
                            <span>{copy.competitionMatchesPlayed}</span>
                            <b>{standing.matchesPlayed > 0 ? standing.matchesPlayed : '—'}</b>
                          </span>
                        </span>
                      </a>
                    </li>
                  )
                })}
              </ol>
            ) : (
              <p class="competition-overview__empty">{copy.competitionNoRankings}</p>
            )}
          </section>
        </article>

        <div class="competition-overview__actions">
          <a class="competition-overview__matches-link" href={matchesPath}>
            {copy.competitionMatches}
          </a>
        </div>

        {seasons.length > 0 && (
          <nav class="competition-season-selector" aria-label={copy.competitionSeasonSelector}>
            <p class="competition-overview__label">{copy.competitionSeasons}</p>
            <ul>
              {seasons.map((season) => (
                <li>
                  <a
                    href={getLocalizedPath(
                      locale,
                      `/competitions/${competitionSlug}/${season.slug}`,
                    )}
                    aria-current={season.slug === selectedSeason.seasonSlug ? 'page' : undefined}
                  >
                    <span>{season.title || season.slug}</span>
                    {season.slug === selectedSeason.seasonSlug && (
                      <span class="competition-season-selector__current">
                        {copy.competitionSeasonCurrent}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </>
    ) : (
      <p class="competition-overview__empty" role="status">{copy.competitionNotFound}</p>
    )}
  </section>
</BaseLayout>

<style>
  .competition-overview-page {
    padding-block: 4rem 6rem;
  }

  .competition-overview-page__header {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .competition-overview-page__eyebrow,
  .competition-overview__label {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .competition-overview-page h1 {
    margin: 0.75rem 0 0;
    color: var(--color-on-background);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7vw, 5rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .competition-overview-page__intro {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    color: var(--color-on-surface-variant);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .competition-overview-page__season-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
  }

  .competition-overview-page__season,
  .competition-overview-page__status {
    margin: 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .competition-overview-page__status {
    color: var(--color-primary);
  }

  .competition-overview {
    display: grid;
    gap: 1px;
    background: var(--color-outline);
  }

  .competition-overview__description,
  .competition-overview__ranking {
    padding: 2rem 1.5rem;
    background: var(--color-surface-container);
  }

  .competition-overview__description h2,
  .competition-overview__ranking h2 {
    margin: 0.5rem 0 0;
    color: var(--color-on-background);
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .competition-overview__description > p:last-child {
    max-width: 50rem;
    margin: 1rem 0 0;
    color: var(--color-on-surface-variant);
    line-height: 1.7;
    white-space: pre-line;
  }

  .competition-overview__section-heading {
    margin-bottom: 1.5rem;
  }

  .competition-ranking-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .competition-ranking-row {
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: 2.5rem 3.5rem minmax(0, 1fr);
    grid-template-areas:
      'rank avatar content'
      'rank avatar stats';
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 0.35rem;
    border: 1px solid var(--color-outline);
    padding: 0.85rem 1rem;
    color: var(--color-on-background);
    background: var(--color-surface-lowest);
    text-decoration: none;
  }

  .competition-ranking-row:hover {
    border-color: var(--color-primary);
  }

  .competition-ranking-row__rank {
    grid-area: rank;
    align-self: start;
    padding-top: 0.15rem;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .competition-ranking-row__avatar {
    grid-area: avatar;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-outline);
    border-radius: 50%;
    color: var(--color-primary);
    background: var(--color-surface-high);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .competition-ranking-row__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .competition-ranking-row__content {
    grid-area: content;
    min-width: 0;
  }

  .competition-ranking-row__content > strong {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .competition-ranking-row__stats {
    display: flex;
    grid-area: stats;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    min-width: 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.72rem;
  }

  .competition-ranking-row__stats > span {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 7.5rem;
  }

  .competition-ranking-row__stats b {
    color: var(--color-on-background);
  }

  @media (min-width: 48rem) {
    .competition-ranking-row {
      grid-template-columns: 3rem 4rem minmax(0, 1fr) auto auto;
      grid-template-areas: 'rank avatar content stats stats';
      column-gap: 1rem;
      row-gap: 0;
      padding: 0.75rem 1rem;
    }

    .competition-ranking-row__rank {
      align-self: center;
      padding-top: 0;
    }

    .competition-ranking-row__avatar {
      width: 4rem;
      height: 4rem;
    }

    .competition-ranking-row__stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(7.5rem, auto));
      gap: 1.5rem;
    }

    .competition-ranking-row__stats > span {
      min-width: 0;
    }
  }

  /* Keep each participant's row readable on the narrowest viewports. */
  @media (max-width: 23rem) {
    .competition-ranking-row {
      grid-template-columns: 2rem 3rem minmax(0, 1fr);
      padding-inline: 0.75rem;
    }

    .competition-ranking-row__avatar {
      width: 3rem;
      height: 3rem;
    }

    .competition-ranking-row__stats > span {
      min-width: 0;
    }
  }

  .competition-overview__actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1px;
    padding: 1.5rem;
    background: var(--color-surface-container);
  }

  .competition-overview__matches-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border: 1px solid var(--color-primary);
    padding: 0.75rem 1rem;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  .competition-overview__matches-link:hover {
    color: var(--color-on-primary);
    background: var(--color-primary);
  }

  .competition-overview__empty {
    margin: 0;
    border-left: 3px solid var(--color-primary);
    padding: 1.25rem 1.5rem;
    color: var(--color-on-surface-variant);
    background: var(--color-surface-lowest);
  }

  .competition-season-selector {
    margin-top: 1px;
    padding: 2rem 1.5rem;
    background: var(--color-surface-container);
  }

  .competition-season-selector ul {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .competition-season-selector a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-outline);
    padding: 0.75rem 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .competition-season-selector a:hover,
  .competition-season-selector a[aria-current='page'] {
    color: var(--color-primary);
  }

  .competition-season-selector__current {
    color: var(--color-primary);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .competition-overview-page {
      padding-block: 5rem 8rem;
    }

    .competition-overview__description,
    .competition-overview__ranking,
    .competition-season-selector {
      padding: 3rem clamp(2rem, 5vw, 5rem);
    }

    .competition-overview__actions {
      padding-inline: clamp(2rem, 5vw, 5rem);
    }

  }
</style>
