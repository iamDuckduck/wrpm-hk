---
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  getLocalizedPath,
  getLocaleCopy,
  getSanityLocaleKey,
  type Locale,
} from '../lib/localization'
import {groupStagesForDisplay} from '../lib/competition-matches'
import {buildSanityImageUrl} from '../lib/sanity-image'
import {sanityClient} from '../lib/sanity'
import {HOME_PAGE_QUERY, type HomePageQueryResult} from '../queries/home-page'
import {
  COMPETITION_SEASON_BY_SLUG_QUERY,
  type CompetitionPageData,
} from '../queries/competition'

interface Props {
  locale: Locale
  competitionSlug: string
  seasonSlug: string
}

const {locale, competitionSlug, seasonSlug} = Astro.props
const copy = getLocaleCopy(locale)
const localeKey = getSanityLocaleKey(locale)

const [homepage, competition] = await Promise.all([
  sanityClient.fetch<HomePageQueryResult>(HOME_PAGE_QUERY, {locale: localeKey}),
  sanityClient.fetch<CompetitionPageData | null>(COMPETITION_SEASON_BY_SLUG_QUERY, {
    locale: localeKey,
    competitionSlug,
    seasonSlug,
  }),
])

const selectedSeason = competition?.season ?? null
const participants = selectedSeason?.participants ?? []
const participantsById = new Map(
  participants.map((participant) => [participant.memberId, participant]),
)
const displayStages = groupStagesForDisplay(selectedSeason?.stages, locale)
const pageTitle = competition?.title?.trim() || copy.competition
const seasonTitle = selectedSeason?.seasonTitle?.trim() || seasonSlug
const overviewPath = selectedSeason
  ? `/competitions/${competitionSlug}/${selectedSeason.seasonSlug}`
  : `/competitions/${competitionSlug}`

function formatScore(score: number) {
  return score > 0 ? `+${score}` : String(score)
}

function formatCompetitionStatus(status: 'upcoming' | 'ongoing' | 'completed') {
  return copy.competitionStatus(status)
}
---

<BaseLayout title={copy.competitionResults} locale={locale} siteSettings={homepage.siteSettings}>
  <section class="competition-matches-page container" aria-labelledby="competition-matches-title">
    <header class="competition-matches-page__header">
      <a class="competition-matches-page__back" href={getLocalizedPath(locale, overviewPath)}>
        <span aria-hidden="true">←</span>
        {copy.competitionBackToSeason}
      </a>
      <p class="competition-matches-page__eyebrow">
        {pageTitle}
        <span aria-hidden="true">·</span>
        {seasonTitle}
      </p>
      <h1 id="competition-matches-title">{copy.competitionResults}</h1>
      {selectedSeason && (
        <p class="competition-matches-page__status">
          {formatCompetitionStatus(selectedSeason.seasonStatus)}
        </p>
      )}
    </header>

    {selectedSeason ? (
      <section class="competition-matches" aria-labelledby="competition-results-title">
        <div class="competition-matches__section-heading">
          <div>
            <p class="competition-matches__kicker">{copy.competitionSelectedSeason}</p>
            <h2 id="competition-results-title">{copy.competitionStageSchedule}</h2>
          </div>
          <p class="competition-matches__summary">
            {copy.competitionStageSummary(displayStages.length)}
          </p>
        </div>

        {displayStages.length > 0 ? (
          <ol class="competition-stages">
            {displayStages.map((stage) => (
              <li class="competition-stage">
                <header class="competition-stage__header">
                  <h3>
                    {stage.title?.trim() ? (
                      <>
                        <span class="competition-stage__title">{stage.title}</span>
                        <span class="competition-stage__separator" aria-hidden="true">|</span>
                      </>
                    ) : null}
                    <time datetime={stage.startsOn}>{stage.dateLabel}</time>
                  </h3>
                </header>

                {stage.matchTypes.length > 0 ? (
                  <div class="competition-stage__content">
                    {stage.matchTypes.map((matchType) => (
                  <section class="competition-match-type" aria-labelledby={`${stage.id}-${matchType.id}-heading`}>
                    <header class="competition-match-type__header">
                      <h4 id={`${stage.id}-${matchType.id}-heading`}>
                        {matchType.title.trim() || matchType.slug}
                      </h4>
                      <span class="competition-match-type__count">
                        {copy.competitionMatchTypeCount(matchType.matches.length)}
                      </span>
                    </header>

                    <ol class="competition-match-grid">
                      {matchType.matches.map((match) => (
                        <li class={`competition-match competition-match--${match.status}`}>
                          <header class="competition-match__header">
                            <h5 class="competition-match__title">
                              <span>{copy.competitionMatchSequence(match.sequence)}</span>
                              <span class="competition-match__separator" aria-hidden="true">|</span>
                              <span class="competition-match__status">
                                {copy.competitionMatchStatus(match.status)}
                              </span>
                            </h5>
                            {match.status === 'completed' && match.detailsUrl ? (
                              <a
                                class="competition-match__details"
                                href={match.detailsUrl}
                                target="_blank"
                                rel="noreferrer"
                              >
                                {copy.competitionMatchDetails}
                                <span aria-hidden="true">↗</span>
                              </a>
                            ) : null}
                          </header>

                          {match.players.length > 0 ? (
                            <ol class={`competition-match__players competition-match__players--${match.status}`}>
                              {match.players.map((player) => {
                                const completedPlayer =
                                  match.status === 'completed' ? player : null
                                const participant = participantsById.get(player.memberId)
                                const name = participant?.name?.trim() || copy.memberUnknown
                                const imageUrl = buildSanityImageUrl(
                                  participant?.profileImage,
                                  {width: 88},
                                )

                                return (
                                  <li class="competition-match-player">
                                    {completedPlayer ? (
                                      <span class="competition-match-player__place">
                                        {completedPlayer.placement}
                                      </span>
                                    ) : null}
                                    <span class="competition-match-player__avatar">
                                      {imageUrl ? (
                                        <img
                                          src={imageUrl}
                                          alt=""
                                          width="44"
                                          height="44"
                                          loading="lazy"
                                        />
                                      ) : (
                                        <span aria-hidden="true">{name.slice(0, 1)}</span>
                                      )}
                                    </span>
                                    <span class="competition-match-player__copy">
                                      {participant?.slug ? (
                                        <a
                                          href={getLocalizedPath(
                                            locale,
                                            `/members/${participant.slug}`,
                                          )}
                                        >
                                          {name}
                                        </a>
                                      ) : (
                                        <span>{name}</span>
                                      )}
                                      {completedPlayer ? (
                                        <strong
                                          class:list={[
                                            'competition-match-player__score',
                                            completedPlayer.score < 0 &&
                                              'competition-match-player__score--negative',
                                          ]}
                                        >
                                          {formatScore(completedPlayer.score)}
                                        </strong>
                                      ) : null}
                                    </span>
                                  </li>
                                )
                              })}
                            </ol>
                          ) : null}
                        </li>
                      ))}
                    </ol>
                  </section>
                    ))}
                  </div>
                ) : null}
              </li>
            ))}
          </ol>
        ) : (
          <p class="competition-matches__empty">{copy.competitionResultsEmpty}</p>
        )}
      </section>
    ) : (
      <p class="competition-matches__empty" role="status">{copy.competitionNotFound}</p>
    )}
  </section>
</BaseLayout>

<style>
  .competition-matches-page {
    padding-block: 4rem 6rem;
  }

  .competition-matches-page__header {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .competition-matches-page__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 2rem;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .competition-matches-page__back:hover {
    text-decoration: underline;
  }

  .competition-matches-page__eyebrow {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .competition-matches-page h1 {
    margin: 0.75rem 0 0;
    color: var(--color-on-background);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7vw, 5rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .competition-matches-page__status {
    margin: 0.75rem 0 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .competition-matches-page__status {
    color: var(--color-primary);
  }

  .competition-matches {
    display: grid;
    gap: 1rem;
  }

  .competition-matches__section-heading h2 {
    margin: 0;
    color: var(--color-on-background);
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .competition-matches__section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .competition-matches__kicker {
    margin: 0 0 0.35rem;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .competition-matches__summary {
    margin: 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: right;
  }

  .competition-stages,
  .competition-match-grid,
  .competition-match__players {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .competition-stages {
    position: relative;
    gap: 1rem;
    padding-left: 2rem;
  }

  .competition-stages::before {
    position: absolute;
    top: 0.65rem;
    bottom: 0.7rem;
    left: 0.5rem;
    width: 2px;
    background: var(--color-primary);
    content: '';
  }

  .competition-stage {
    position: relative;
    min-width: 0;
    display: grid;
    gap: 0;
  }

  .competition-stage::before {
    position: absolute;
    z-index: 1;
    top: 0.38rem;
    left: -1.75rem;
    width: 0.85rem;
    height: 0.85rem;
    border: 2px solid var(--color-background);
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
    content: '';
  }

  .competition-stage__header {
    min-height: 2rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    background: linear-gradient(90deg, rgb(100 7 14 / 95%), rgb(60 4 8 / 95%));
  }

  .competition-stage__header h3 {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0;
    padding: 0.42rem 1.2rem;
    color: var(--color-on-background);
    font-family: var(--font-label);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }

  .competition-stage__separator {
    color: rgb(226 226 226 / 45%);
  }

  .competition-stage__header time {
    color: #ded2d2;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .competition-stage__content {
    display: grid;
    gap: 1.25rem;
    border: 1px solid var(--color-outline);
    border-top: 0;
    padding: 1rem 1.4rem 1.35rem;
    background: var(--color-surface-lowest);
  }

  .competition-match-type {
    min-width: 0;
    display: grid;
    gap: 0.55rem;
  }

  .competition-match-type__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-left: 4px solid var(--color-primary);
    padding: 0.15rem 0.7rem;
  }

  .competition-match-type__header h4 {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .competition-match-type__count {
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .competition-match-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  .competition-match {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-outline);
    background: var(--color-surface);
  }

  .competition-match__header {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid var(--color-outline);
    padding: 0.35rem 0.8rem;
  }

  .competition-match__title {
    display: inline-flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-on-background);
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .competition-match__separator {
    color: var(--color-on-surface-variant);
  }

  .competition-match__status {
    color: var(--color-on-surface-variant);
    font-size: 0.64rem;
    font-weight: 500;
  }

  .competition-match--completed .competition-match__status {
    color: var(--color-primary);
  }

  .competition-match--scheduled .competition-match__status,
  .competition-match--cancelled .competition-match__status {
    color: var(--color-on-surface-variant);
  }

  .competition-match--cancelled .competition-match__status {
    opacity: 0.72;
  }

  .competition-match__details {
    flex: 0 0 auto;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .competition-match__details:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .competition-match__players {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }

  .competition-match-player {
    display: grid;
    min-width: 0;
    min-height: 3.55rem;
    grid-template-columns: 2.45rem minmax(0, 1fr);
    align-items: center;
    gap: 0.48rem;
    border-right: 1px solid var(--color-outline);
    border-bottom: 1px solid var(--color-outline);
    padding: 0.38rem 0.65rem;
  }

  .competition-match__players--completed .competition-match-player {
    grid-template-columns: 1.55rem 2.45rem minmax(0, 1fr);
  }

  .competition-match-player:nth-child(even) {
    border-right: 0;
  }

  .competition-match-player:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .competition-match-player__place {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border-radius: 0.15rem;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .competition-match-player__avatar {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-outline);
    border-radius: 50%;
    color: var(--color-primary);
    background: var(--color-surface-high);
    font-family: var(--font-display);
    font-size: 0.9rem;
  }

  .competition-match-player__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .competition-match-player__copy {
    display: grid;
    min-width: 0;
    gap: 0.12rem;
  }

  .competition-match-player__copy a,
  .competition-match-player__copy > span {
    overflow: hidden;
    color: var(--color-on-background);
    font-family: var(--font-body);
    font-size: 0.77rem;
    font-weight: 700;
    text-overflow: ellipsis;
    text-decoration: none;
    white-space: nowrap;
  }

  .competition-match-player__copy a:hover {
    color: var(--color-primary);
  }

  .competition-match-player__score {
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .competition-match-player__score--negative {
    color: #ff4b57;
  }

  .competition-matches__empty {
    margin: 0;
    border-left: 3px solid var(--color-primary);
    padding: 1.25rem 1.5rem;
    color: var(--color-on-surface-variant);
    background: var(--color-surface-lowest);
  }

  @media (min-width: 46rem) {
    .competition-match-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .competition-matches-page {
      padding-block: 5rem 8rem;
    }
  }

  @media (max-width: 45.99rem) {
    .competition-matches__section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.6rem;
    }

    .competition-matches__summary {
      text-align: left;
    }

    .competition-stages {
      padding-left: 1.5rem;
    }

    .competition-stage::before {
      left: -1.55rem;
      width: 0.75rem;
      height: 0.75rem;
    }

    .competition-stage__header h3 {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.05rem;
      padding: 0.48rem 0.8rem;
      font-size: 0.78rem;
    }

    .competition-stage__separator {
      display: none;
    }

    .competition-stage__content {
      gap: 1rem;
      padding: 0.8rem 0.7rem 1rem;
    }

    .competition-match__header {
      padding-inline: 0.65rem;
    }
  }
</style>
