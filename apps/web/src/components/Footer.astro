---
import type {SiteBranding} from '../lib/site-branding'
import {getLocaleCopy, type Locale} from '../lib/localization'

interface Props {
  branding: SiteBranding
  locale: Locale
}

const {branding, locale} = Astro.props
const copy = getLocaleCopy(locale)
const currentYear = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <p class="site-footer__brand">{branding.organizationName}</p>
    <p>&copy; {currentYear} {copy.footerRights}</p>
  </div>
</footer>
