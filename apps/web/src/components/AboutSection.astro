---
import {getLocaleCopy, type Locale} from '../lib/localization'

interface Props {
  heading: string | null
  locale: Locale
  text: string | null
}

const {heading, locale, text} = Astro.props
const copy = getLocaleCopy(locale)
const aboutHeading = heading?.trim() || copy.about
const aboutText = text?.trim() || ''
---

<section class="about-section" aria-labelledby="about-heading">
  <div class="about-section__inner">
    <div class="about-section__decor" aria-hidden="true"></div>

    <div class="about-section__content">
      <p class="about-section__eyebrow">{copy.about}</p>
      <h2 id="about-heading">{aboutHeading}</h2>
      {aboutText && <p class="about-section__text">{aboutText}</p>}
    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--color-background);
    padding: 5rem var(--space-4);
  }

  .about-section__inner {
    position: relative;
    display: grid;
    width: min(100%, var(--container-width));
    margin-inline: auto;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-4);
  }

  .about-section__decor {
    position: absolute;
    top: -2.5rem;
    left: -2.5rem;
    width: 10rem;
    height: 10rem;
    border-top: 2px solid rgb(230 0 18 / 30%);
    border-left: 2px solid rgb(230 0 18 / 30%);
    pointer-events: none;
  }

  .about-section__content {
    position: relative;
    z-index: 1;
    display: flex;
    grid-column: 1 / -1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .about-section__eyebrow {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .about-section h2 {
    max-width: 16ch;
    margin: 0;
    color: var(--color-on-background);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .about-section__text {
    max-width: 40rem;
    margin: 0;
    color: var(--color-on-surface-variant);
    font-size: 1rem;
    line-height: 1.625;
    text-wrap: pretty;
  }

  @media (max-width: 47.999rem) {
    .about-section {
      padding: 2.5rem var(--space-4) 5rem;
    }

    .about-section__inner {
      display: block;
    }

    .about-section__decor {
      top: 0;
      left: -1rem;
    }

    .about-section__content {
      padding-top: 5rem;
    }

    .about-section h2 {
      font-size: 2rem;
      line-height: 1.2;
    }
  }
</style>
