---
import LeagueOverviewPage from '../../components/LeagueOverviewPage.astro'
import {getSanityLocaleKey} from '../../lib/localization'
import {sanityClient} from '../../lib/sanity'
import {LEAGUE_SEASON_SLUGS_QUERY, type LeagueSeasonSummary} from '../../queries/league'

export async function getStaticPaths() {
  const seasons = await sanityClient.fetch<LeagueSeasonSummary[]>(LEAGUE_SEASON_SLUGS_QUERY, {
    locale: getSanityLocaleKey('zh-HK'),
  })

  return seasons.map(({slug}) => ({
    params: {seasonSlug: slug},
    props: {seasonSlug: slug},
  }))
}

const {seasonSlug} = Astro.props as {seasonSlug: string}
---

<LeagueOverviewPage locale="zh-HK" seasonSlug={seasonSlug} />
