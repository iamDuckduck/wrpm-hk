---
import LeagueOverviewPage from '../../../components/LeagueOverviewPage.astro'
import {PUBLIC_LOCALES, getSanityLocaleKey, type Locale} from '../../../lib/localization'
import {sanityClient} from '../../../lib/sanity'
import {LEAGUE_SEASON_SLUGS_QUERY, type LeagueSeasonSummary} from '../../../queries/league'

export async function getStaticPaths() {
  return (
    await Promise.all(
      PUBLIC_LOCALES.map(async (locale) => {
        const seasons = await sanityClient.fetch<LeagueSeasonSummary[]>(
          LEAGUE_SEASON_SLUGS_QUERY,
          {locale: getSanityLocaleKey(locale)},
        )

        return seasons.map(({slug}) => ({
          params: {locale, seasonSlug: slug},
          props: {locale, seasonSlug: slug},
        }))
      }),
    )
  ).flat()
}

const {locale, seasonSlug} = Astro.props as {locale: Locale; seasonSlug: string}
---

<LeagueOverviewPage locale={locale} seasonSlug={seasonSlug} />
