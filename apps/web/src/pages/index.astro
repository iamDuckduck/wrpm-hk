---
import BaseLayout from '../layouts/BaseLayout.astro'
import {sanityClient} from '../lib/sanity'
import {
  HOME_PAGE_QUERY,
  type HomePageQueryResult,
} from '../queries/home-page'

const homepage = await sanityClient.fetch<HomePageQueryResult>(HOME_PAGE_QUERY)
---

<BaseLayout title="首頁" siteSettings={homepage.siteSettings}>
  <section class="homepage-placeholder container" aria-labelledby="homepage-title">
    <div class="homepage-placeholder__content">
      <p class="homepage-placeholder__eyebrow">WRPM / HOME</p>
      <h1 id="homepage-title">網站內容<br /><span>準備中</span></h1>
      <p class="homepage-placeholder__note">CMS HOMEPAGE FOUNDATION</p>
    </div>
  </section>
</BaseLayout>

<style>
  .homepage-placeholder {
    display: grid;
    min-height: calc(100svh - var(--header-height));
    align-content: center;
    padding-block: var(--section-padding);
  }

  .homepage-placeholder::before {
    position: fixed;
    z-index: -1;
    inset: var(--header-height) 0 0;
    background:
      linear-gradient(135deg, transparent 55%, rgb(230 0 18 / 8%)),
      radial-gradient(circle at 15% 20%, rgb(230 0 18 / 12%), transparent 30%);
    content: '';
    pointer-events: none;
  }

  .homepage-placeholder__content {
    max-width: 54rem;
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-6);
  }

  .homepage-placeholder__eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-on-background);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 10vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  h1 span {
    color: var(--color-primary);
  }

  .homepage-placeholder__note {
    margin: var(--space-8) 0 0;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  @media (min-width: 48rem) {
    .homepage-placeholder__content {
      padding-left: var(--space-8);
    }
  }
</style>
