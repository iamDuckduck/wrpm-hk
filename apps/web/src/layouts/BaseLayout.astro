---
import Footer from '../components/Footer.astro'
import Navbar from '../components/Navbar.astro'
import {getLocaleCopy, type Locale} from '../lib/localization'
import {resolveSiteBranding} from '../lib/site-branding'
import type {SiteSettings} from '../queries/home-page'
import '../styles/global.css'

interface Props {
  title: string
  locale: Locale
  siteSettings: SiteSettings | null
}

const {title, locale, siteSettings} = Astro.props
const branding = resolveSiteBranding(siteSettings)
const copy = getLocaleCopy(locale)
const pageTitle = `${title} | ${branding.organizationName}`
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={copy.pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@500;700&family=Noto+Sans+TC:wght@400;600;700&family=Sora:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <div class="site-shell">
      <Navbar branding={branding} locale={locale} />
      <main id="main-content">
        <slot />
      </main>
      <Footer branding={branding} locale={locale} />
    </div>
  </body>
</html>
